# Copy this file to .env locally. Never commit the real .env file.
MONGODB_URL=mongodb+srv://APP_USER:CHANGE_ME@CLUSTER.mongodb.net/?retryWrites=true&w=majority
DB_NAME=lefaxeur_db
SECRET_KEY=GENERATE_A_RANDOM_VALUE_OF_AT_LEAST_32_CHARACTERS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=https://your-frontend.example
MAX_UPLOAD_BYTES=10485760
LOGIN_RATE_WINDOW_MINUTES=15
EXPOSE_API_DOCS=false
SMTP_SERVER=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
GOOGLE_APPLICATION_CREDENTIALS=
